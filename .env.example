# Copy this file to .env for local use, or set the same values as hosting secrets.
# Never commit the real .env file.
FACTORY_USERNAME=syadmin
FACTORY_PASSWORD=change-this-before-deploy
# Optional: use the base64url SHA-256 digest printed by `npm run hash-password -- <password> <session-secret>` instead of FACTORY_PASSWORD.
# FACTORY_PASSWORD_HASH=
FACTORY_SESSION_SECRET=replace-with-a-long-random-secret
